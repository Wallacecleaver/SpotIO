# Application Spotify : OPTIONNEL (uniquement pour le mode « compte Spotify », Premium requis)
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# URL publique de l'addon, sans slash final (https obligatoire, sauf http://127.0.0.1 en local)
# Redirect URI à déclarer chez Spotify : <BASE_URL>/auth/callback
BASE_URL=http://127.0.0.1:7000

# Chaîne aléatoire longue : chiffre le refresh token dans l'URL de l'addon
SECRET=change-me
# Clé d'accès au dashboard (/dashboard). Laisse vide pour le désactiver.
ADMIN_KEY=
# Optionnel : clé YouTube Data API v3 (sinon scraping de la recherche YouTube)
YT_API_KEY=
# Optionnel : instances Piped (API) / Invidious à utiliser, séparées par des virgules (sinon découverte auto)
PIPED_INSTANCES=
INVIDIOUS_INSTANCES=
# Optionnel
PORT=7000
DATA_DIR=./data
